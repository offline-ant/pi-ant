{
  "name": "pi-ant",
  "version": "1.0.0",
  "description": "Ant's local pi extension package",
  "keywords": [
    "pi-package",
    "pi-extension",
    "personal"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "bin": {
    "browser-io": "./bin/browser-io",
    "pi-guidance-loop": "./bin/pi-guidance-loop"
  },
  "pi": {
    "extensions": [
