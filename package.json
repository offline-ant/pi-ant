      "./extensions/guidance.ts",
      "./extensions/ugo.ts",
      "./extensions/ask.ts",
      "./extensions/reflect.ts",
      "./extensions/working-text.ts",
      "./extensions/sqlite.ts",
      "./extensions/cwd.ts",
      "./extensions/git-commit.ts",
      "./extensions/workboard.ts",
      "./extensions/worktree.ts",
      "./extensions/context-explorer.ts",
      "./extensions/browser.ts",
      "./extensions/web.ts",
      "./extensions/prompt-history.ts",
      "./extensions/fresh-pov-review.ts",
      "./extensions/vim.ts",
      "./extensions/agents-d.ts",
      "./extensions/tool-profile.ts"
