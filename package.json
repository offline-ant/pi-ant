{
  "name": "pi-ant",
  "version": "1.0.0",
  "type": "module",
  "description": "Pi extensions: safety lints, session tools, workflows and skills",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offline-ant/pi-ant.git"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "bin": {
    "pi-guidance-loop": "./bin/pi-guidance-loop"
  },
  "pi": {
    "skills": ["./skills"],
    "extensions": [
      "./extensions/lints.ts",
      "./extensions/exec-lints.ts",
      "./extensions/tweaks.ts",
      "./extensions/guidance.ts",
      "./extensions/ugo.ts",
      "./extensions/ask.ts",
      "./extensions/herdr-finish.ts",
      "./extensions/working-text.ts",
      "./extensions/cwd.ts",
      "./extensions/copy-quote/index.ts",
      "./extensions/git-commit.ts",
      "./extensions/workboard.ts",
      "./extensions/init-agents-md.ts",
      "./extensions/worktree.ts",
      "./extensions/document-flow-review.ts",
      "./extensions/vim.ts",
      "./extensions/agents-d.ts",
      "./extensions/self-compact.ts",
      "./extensions/tools.ts"
    ]
  }
}
