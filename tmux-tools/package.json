{
  "name": "tmux-tools",
  "version": "1.0.0",
  "description": "Tmux-backed pi orchestration tools and worker workflows",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tmux",
    "workers"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "bin": {
    "pi-semaphore": "./bin/pi-semaphore",
    "pi-tmux": "./bin/pi-tmux",
    "pi-claude-agent": "./bin/pi-claude-agent",
    "clear-stale": "./bin/clear-stale"
  },
  "pi": {
    "extensions": [
      "./extensions/nesting.ts",
      "./extensions/semaphore-locks.ts",
      "./extensions/tool-model.ts",
      "./extensions/worker-frame.ts",
      "./extensions/call.ts",
      "./extensions/coding-agent.ts",
      "./extensions/minitask.ts",
      "./extensions/tmux.ts",
      "./extensions/tmux-fork.ts"
    ]
  }
}
